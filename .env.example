[TEMPLATE]
# Copy to .env and fill in. .env is gitignored.

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Error reporting (optional)
SENTRY_DSN=

# Database — ownership history, admin analytics
NEON_DATABASE_URL=

# Cache (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin
ADMIN_KEY=
ADMIN_SESSION_SECRET=
SESSION_SECRET=

# AI features (optional)
GEMINI_API_KEY=
ODDS_API_KEY=
