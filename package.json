    "@fontsource/material-symbols-outlined": "^5.3.2",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/node": "^10.70.0",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^1.3.2",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "express": "4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "node-html-parser": "^9.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "tesseract.js": "^6.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.10"
