{
  "name": "fpl-stats",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "vite",
    "dev:server": "node src/server.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "update:fotmob-ids": "node scripts/update-fotmob-player-ids.mjs",
    "generate:positions": "node scripts/generate-player-positions.mjs",
    "check": "node --check src/server.js && node --check src/decisionModel.js && node --check public/common.js && node --check public/squad-import.js && node --check public/team-preferences.js && tsc -b",
    "test": "node tests/captaincy-model.mjs && node tests/decision-model.mjs && node tests/ai-team-model.mjs && node tests/squad-import.mjs && node tests/team-preferences.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
